# Claude API 설정
ANTHROPIC_API_KEY=your-api-key-here
CLAUDE_MODEL=claude-sonnet-4-6

# Flask 설정
FLASK_DEBUG=false
SECRET_KEY=your-secret-key-here

# DB 경로 (선택, 기본값: ./reports.db)
# DB_PATH=/path/to/reports.db

# Tavily 검색 API (선택 — 미설정 시 AI 단독 생성으로 fallback)
# https://app.tavily.com 에서 발급
TAVILY_API_KEY=your-tavily-api-key-here

# 국가법령정보센터 API (선택 — 미설정 시 AI 단독 생성으로 fallback)
# https://open.law.go.kr 회원가입 후 사용자 ID가 API 키
LAW_API_KEY=your-law-api-key-here
